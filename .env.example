# Madalena Network Intelligence — placeholders only. Never put real secrets here.
# Copy to .env for local Docker Compose (gitignored).

COMPOSE_PROJECT_NAME=madalena-ni

# PostgreSQL
POSTGRES_DB=madalena
POSTGRES_USER=madalena
POSTGRES_PASSWORD=change_me_in_local_env_only
DATABASE_URL=postgresql+psycopg://madalena:change_me_in_local_env_only@db:5432/madalena

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# CDR portal runtime read-only connection
CDR_DB_URL=
CDR_DB_RO_URL=
CDR_DB_PASSWORD=
CDR_SECRET_PREFIX=ASTERISK_LESANTE_CDR_DB
CDR_SECRET_FALLBACK_PREFIX=ASTERISK_CDR_DB
CDR_PORTAL_SECRET_PREFIX=CDR_PORTAL
# Runtime secret provider (Cofre Central)
SECRET_PROVIDER=infisical
INFISICAL_URL=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=production

# CDR read-only runtime secrets, if exposed directly by the Cofre.
CDR_DB_URL=
CDR_DB_RO_URL=
CDR_DB_PASSWORD=
ASTERISK_LESANTE_CDR_DB_HOST=
ASTERISK_LESANTE_CDR_DB_PORT=
ASTERISK_LESANTE_CDR_DB_NAME=
ASTERISK_LESANTE_CDR_DB_USER=
ASTERISK_LESANTE_CDR_DB_PASSWORD=
ASTERISK_LESANTE_CDR_DB_SSLMODE=

# Example reference only — collectors resolve secrets at runtime from the provider:
# SECRET_PREFIX_EXAMPLE=DEVICE_TENANT_SITE_ROLE

# Scheduler intervals (seconds)
SCHEDULER_MIKROTIK_INTERVAL_SEC=900
SCHEDULER_OLT_INTERVAL_SEC=1800
SCHEDULER_UNIFI_INTERVAL_SEC=1800
SCHEDULER_FULL_INVENTORY_INTERVAL_SEC=21600
SCHEDULER_ENABLED=true

# Lab seed (non-secret labels only)
SEED_TENANT_SLUG=example-tenant
SEED_SITE_SLUG=example-site
# Optional: persist-exclusion example (synthetic). Leave unset in Git-backed files.
# SEED_EXCLUDE_VLAN=999

# Host path to trusted SSH known_hosts (read-only in the container at /run/ssh/known_hosts).
# Do not commit real host keys. Example: /etc/madalena-ni/known_hosts
# NI_SSH_KNOWN_HOSTS_FILE=./deploy/ssh/known_hosts
# NI_SSH_KNOWN_HOSTS=/run/ssh/known_hosts

# UniFi private CA/chain (PEM) directory mounted at /run/tls when verification stays on:
# NI_TRUST_DIR=./deploy/tls
# NI_TLS_CA_FILE=/run/tls/unifi-ca.pem
# Optional when BASE_URL is an IP and verification stays on:
# {PREFIX}_TLS_SERVER_NAME=unifi.example.invalid
# UniFi-only lab exception (does not affect SSH): {PREFIX}_VERIFY_TLS=false

# Host-side validate-deployment.sh (only if API/MCP are not on 8000/8081):
# VALIDATE_API_URL=http://127.0.0.1:<api-port>
# VALIDATE_MCP_URL=http://127.0.0.1:<mcp-port>

# Device secrets are injected at runtime as {PREFIX}_HOST, {PREFIX}_USERNAME,
# {PREFIX}_PASSWORD, optional {PREFIX}_SSH_PORT / {PREFIX}_PROTOCOL.
# UniFi Network also uses {PREFIX}_BASE_URL, {PREFIX}_API_KEY, optional {PREFIX}_SITE,
# optional {PREFIX}_TLS_CA, optional {PREFIX}_TLS_SERVER_NAME,
# optional {PREFIX}_VERIFY_TLS=false (UniFi-only lab exception).
# Example prefixes after seed: DEVICE_EXAMPLE_MIKROTIK, DEVICE_EXAMPLE_MIKROTIK_B,
# DEVICE_EXAMPLE_OLT, DEVICE_EXAMPLE_UNIFI
# Never commit real values.
