# Madalena Network Intelligence — placeholders only. Never put real secrets here.
# Copy to .env for local Docker Compose (gitignored).

COMPOSE_PROJECT_NAME=madalena-ni

# PostgreSQL
POSTGRES_DB=madalena
POSTGRES_USER=madalena
POSTGRES_PASSWORD=change_me_in_local_env_only
DATABASE_URL=postgresql+psycopg://madalena:change_me_in_local_env_only@db:5432/madalena

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Secrets provider (external — Infisical or equivalent). No passwords in this file.
SECRET_PROVIDER=infisical
# Example reference only — collectors resolve secrets at runtime from the provider:
# SECRET_PREFIX_EXAMPLE=DEVICE_TENANT_SITE_ROLE

# Scheduler intervals (seconds)
SCHEDULER_MIKROTIK_INTERVAL_SEC=900
SCHEDULER_OLT_INTERVAL_SEC=1800
SCHEDULER_FULL_INVENTORY_INTERVAL_SEC=21600
SCHEDULER_ENABLED=true

# Lab seed (non-secret labels only)
SEED_TENANT_SLUG=example-tenant
SEED_SITE_SLUG=example-site
